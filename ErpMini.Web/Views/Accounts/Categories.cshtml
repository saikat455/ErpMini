<!-- ErpMini.Web/Views/Accounts/Categories.cshtml -->
@model IEnumerable<ErpMini.Application.DTOs.AccountCategoryDto>
@{ ViewData["Title"] = "Account Categories"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <p class="page-header-title">Account Categories</p>
        <p class="page-header-sub">Manage income and expense categories</p>
    </div>
    <button class="btn btn-dark btn-sm px-3"
            data-bs-toggle="modal" data-bs-target="#addModal">
        <i class="bi bi-plus-lg me-1"></i> Add Category
    </button>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Type</th>
                    <th>Description</th>
                    <th>Transactions</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td class="fw-medium">@c.Name</td>
                    <td>
                        <span class="badge @(c.Type == "Income" ? "badge-active" : "badge-inactive")">
                            @c.Type
                        </span>
                    </td>
                    <td class="text-muted">@(c.Description ?? "—")</td>
                    <td>
                        <span class="badge bg-light text-dark border">
                            @c.TransactionCount
                        </span>
                    </td>
                    <td>
                        <span class="badge @(c.IsActive ? "badge-active" : "badge-inactive")">
                            @(c.IsActive ? "Active" : "Inactive")
                        </span>
                    </td>
                    <td class="text-end pe-3">
                        <form asp-action="DeleteCategory" asp-route-id="@c.Id"
                              method="post" class="d-inline"
                              onsubmit="return confirm('Delete @c.Name?')">
                            @Html.AntiForgeryToken()
                            <button class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<!-- Add Modal -->
<div class="modal fade" id="addModal" tabindex="-1">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h6 class="modal-title fw-semibold">Add Category</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="CreateCategory" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-medium">Name</label>
                        <input name="name" class="form-control" required
                               placeholder="e.g. Consulting Income" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-medium">Type</label>
                        <select name="type" class="form-select" required>
                            <option value="Income">Income</option>
                            <option value="Expense">Expense</option>
                        </select>
                    </div>
                    <div class="mb-2">
                        <label class="form-label fw-medium">Description</label>
                        <input name="description" class="form-control"
                               placeholder="Optional" />
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="submit" class="btn btn-dark btn-sm">Add</button>
                    <button type="button" class="btn btn-outline-secondary btn-sm"
                            data-bs-dismiss="modal">Cancel</button>
                </div>
            </form>
        </div>
    </div>
</div>
<!-- ErpMini.Web/Views/Shared/_Pagination.cshtml -->
@model ErpMini.Application.Helpers.PagedList<dynamic>

@if (Model.TotalPages > 1)
{
    <div class="d-flex justify-content-between align-items-center px-3 py-2 border-top"
         style="font-size:.8rem">
        <span class="text-muted">
            Showing @((Model.PageNumber - 1) * Model.PageSize + 1)–@(Math.Min(Model.PageNumber * Model.PageSize, Model.TotalCount))
            of @Model.TotalCount records
        </span>
        <nav>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(!Model.HasPrev ? "disabled" : "")">
                    <a class="page-link" asp-route-page="@(Model.PageNumber - 1)">‹</a>
                </li>
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                        <a class="page-link" asp-route-page="@i">@i</a>
                    </li>
                }
                <li class="page-item @(!Model.HasNext ? "disabled" : "")">
                    <a class="page-link" asp-route-page="@(Model.PageNumber + 1)">›</a>
                </li>
            </ul>
        </nav>
    </div>
}
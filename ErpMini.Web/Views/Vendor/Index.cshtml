<!-- ErpMini.Web/Views/Vendor/Index.cshtml -->
@model IEnumerable<ErpMini.Application.DTOs.VendorDto>
@{ ViewData["Title"] = "Vendors"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <p class="page-header-title">Vendors</p>
        <p class="page-header-sub">Manage supplier information</p>
    </div>
    <button class="btn btn-dark btn-sm px-3"
            data-bs-toggle="modal" data-bs-target="#addModal">
        <i class="bi bi-plus-lg me-1"></i> Add Vendor
    </button>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Contact Person</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Orders</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var v in Model)
            {
                <tr>
                    <td class="fw-medium">@v.Name</td>
                    <td>@v.ContactPerson</td>
                    <td>@v.Email</td>
                    <td>@v.Phone</td>
                    <td><span class="badge bg-light text-dark border">@v.TotalOrders</span></td>
                    <td>
                        <span class="badge @(v.IsActive ? "badge-active" : "badge-inactive")">
                            @(v.IsActive ? "Active" : "Inactive")
                        </span>
                    </td>
                    <td class="text-end pe-3">
                        <button class="btn btn-sm btn-outline-primary me-1"
                                data-bs-toggle="modal"
                                data-bs-target="#editModal-@v.Id">
                            <i class="bi bi-pencil"></i>
                        </button>
                        <form asp-action="Delete" asp-route-id="@v.Id"
                              method="post" class="d-inline"
                              onsubmit="return confirm('Delete @v.Name?')">
                            @Html.AntiForgeryToken()
                            <button class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>

                <!-- Edit Modal -->
                <div class="modal fade" id="editModal-@v.Id" tabindex="-1">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-header border-0 pb-0">
                                <h6 class="modal-title fw-semibold">Edit Vendor</h6>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>
                            <form asp-controller="Vendor" asp-action="Edit" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="Id" value="@v.Id" />
                                <div class="modal-body">
                                    <div class="row g-3">
                                        <div class="col-12">
                                            <label class="form-label fw-medium">Company Name</label>
                                            <input name="Name" class="form-control" value="@v.Name" required />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label fw-medium">Contact Person</label>
                                            <input name="ContactPerson" class="form-control" value="@v.ContactPerson" required />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label fw-medium">Phone</label>
                                            <input name="Phone" class="form-control" value="@v.Phone" required />
                                        </div>
                                        <div class="col-12">
                                            <label class="form-label fw-medium">Email</label>
                                            <input name="Email" type="email" class="form-control" value="@v.Email" required />
                                        </div>
                                        <div class="col-12">
                                            <label class="form-label fw-medium">Address</label>
                                            <input name="Address" class="form-control" value="@v.Address" />
                                        </div>
                                    </div>
                                </div>
                                <div class="modal-footer border-0 pt-0">
                                    <button type="submit" class="btn btn-dark btn-sm">Save</button>
                                    <button type="button" class="btn btn-outline-secondary btn-sm"
                                            data-bs-dismiss="modal">Cancel</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            }
            </tbody>
        </table>
        @if (!Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-building" style="font-size:2rem"></i>
                <p class="mt-2 mb-0">No vendors found.</p>
            </div>
        }
    </div>
</div>

<!-- Add Modal -->
<div class="modal fade" id="addModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h6 class="modal-title fw-semibold">Add Vendor</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-controller="Vendor" asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label fw-medium">Company Name</label>
                            <input name="Name" class="form-control" required placeholder="ABC Supplies Ltd." />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium">Contact Person</label>
                            <input name="ContactPerson" class="form-control" required placeholder="John Doe" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium">Phone</label>
                            <input name="Phone" class="form-control" required placeholder="+880..." />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-medium">Email</label>
                            <input name="Email" type="email" class="form-control" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-medium">Address</label>
                            <input name="Address" class="form-control" placeholder="Optional" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="submit" class="btn btn-dark btn-sm">Add Vendor</button>
                    <button type="button" class="btn btn-outline-secondary btn-sm"
                            data-bs-dismiss="modal">Cancel</button>
                </div>
            </form>
        </div>
    </div>
</div>
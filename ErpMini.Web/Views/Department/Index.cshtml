@model IEnumerable<ErpMini.Application.DTOs.DepartmentDto>
@{ ViewData["Title"] = "Departments"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <p class="page-header-title">Departments</p>
        <p class="page-header-sub">Manage company departments</p>
    </div>
    <button class="btn btn-dark btn-sm px-3"
            data-bs-toggle="modal" data-bs-target="#addModal">
        <i class="bi bi-plus-lg me-1"></i> Add Department
    </button>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Employees</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var dept in Model)
            {
                <tr>
                    <td class="text-muted">@dept.Id</td>
                    <td class="fw-medium">@dept.Name</td>
                    <td class="text-muted">@(dept.Description ?? "—")</td>
                    <td>
                        <span class="badge bg-light text-dark border">
                            @dept.EmployeeCount
                        </span>
                    </td>
                    <td>
                        <span class="badge @(dept.IsActive ? "badge-active" : "badge-inactive")">
                            @(dept.IsActive ? "Active" : "Inactive")
                        </span>
                    </td>
                    <td class="text-end pe-3">
                        <button class="btn btn-sm btn-outline-primary me-1"
                                data-bs-toggle="modal"
                                data-bs-target="#editModal-@dept.Id">
                            <i class="bi bi-pencil"></i>
                        </button>
                        <form asp-action="Delete" asp-route-id="@dept.Id"
                              method="post" class="d-inline"
                              onsubmit="return confirm('Delete @dept.Name?')">
                            @Html.AntiForgeryToken()
                            <button class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>

                <!-- Edit Modal -->
                <div class="modal fade" id="editModal-@dept.Id" tabindex="-1">
                    <div class="modal-dialog modal-sm">
                        <div class="modal-content">
                            <div class="modal-header border-0 pb-0">
                                <h6 class="modal-title fw-semibold">Edit Department</h6>
                                <button type="button" class="btn-close"
                                        data-bs-dismiss="modal"></button>
                            </div>
                            <form asp-action="Edit" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@dept.Id" />
                                <div class="modal-body">
                                    <div class="mb-3">
                                        <label class="form-label fw-medium">Name</label>
                                        <input name="name" class="form-control"
                                               value="@dept.Name" required />
                                    </div>
                                    <div class="mb-2">
                                        <label class="form-label fw-medium">Description</label>
                                        <input name="description" class="form-control"
                                               value="@dept.Description" />
                                    </div>
                                </div>
                                <div class="modal-footer border-0 pt-0">
                                    <button type="submit" class="btn btn-dark btn-sm">Save</button>
                                    <button type="button"
                                            class="btn btn-outline-secondary btn-sm"
                                            data-bs-dismiss="modal">Cancel</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            }
            </tbody>
        </table>

        @if (!Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-diagram-3" style="font-size:2rem"></i>
                <p class="mt-2 mb-0">No departments found.</p>
            </div>
        }
    </div>
</div>

<!-- Add Modal -->
<div class="modal fade" id="addModal" tabindex="-1">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h6 class="modal-title fw-semibold">Add Department</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-medium">Name</label>
                        <input name="name" class="form-control" required
                               placeholder="e.g. Marketing" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label fw-medium">Description</label>
                        <input name="description" class="form-control"
                               placeholder="Optional" />
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="submit" class="btn btn-dark btn-sm">Add</button>
                    <button type="button" class="btn btn-outline-secondary btn-sm"
                            data-bs-dismiss="modal">Cancel</button>
                </div>
            </form>
        </div>
    </div>
</div>
<!-- ErpMini.Web/Views/Leave/Apply.cshtml -->
@model ErpMini.Web.ViewModels.ApplyLeaveViewModel
@{ ViewData["Title"] = "Apply for Leave"; }

<div class="d-flex align-items-center gap-2 mb-4">
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
        <i class="bi bi-arrow-left"></i>
    </a>
    <div>
        <h5 class="mb-0 fw-semibold">Apply for Leave</h5>
        <small class="text-muted">Submit a new leave request</small>
    </div>
</div>

<div class="row">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header">Leave Request Details</div>
            <div class="card-body">
                <form asp-action="Apply" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label asp-for="EmployeeId" class="form-label fw-medium"></label>
                        <select asp-for="EmployeeId" asp-items="Model.Employees" class="form-select">
                            <option value="">— Select Employee —</option>
                        </select>
                        <span asp-validation-for="EmployeeId" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="LeaveTypeId" class="form-label fw-medium"></label>
                        <select asp-for="LeaveTypeId" asp-items="Model.LeaveTypes" class="form-select">
                            <option value="">— Select Leave Type —</option>
                        </select>
                        <span asp-validation-for="LeaveTypeId" class="text-danger small"></span>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label asp-for="FromDate" class="form-label fw-medium"></label>
                            <input asp-for="FromDate" type="date" class="form-control"
                                   value="@Model.FromDate.ToString("yyyy-MM-dd")" />
                            <span asp-validation-for="FromDate" class="text-danger small"></span>
                        </div>
                        <div class="col-6">
                            <label asp-for="ToDate" class="form-label fw-medium"></label>
                            <input asp-for="ToDate" type="date" class="form-control"
                                   value="@Model.ToDate.ToString("yyyy-MM-dd")" />
                            <span asp-validation-for="ToDate" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="mb-4">
                        <label asp-for="Reason" class="form-label fw-medium"></label>
                        <textarea asp-for="Reason" class="form-control" rows="3"
                                  placeholder="Briefly explain the reason for leave..."></textarea>
                        <span asp-validation-for="Reason" class="text-danger small"></span>
                    </div>
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-dark">
                            <i class="bi bi-send me-1"></i> Submit Application
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card">
            <div class="card-header">Leave Policy</div>
            <div class="card-body p-0">
                <table class="table mb-0">
                    <thead>
                        <tr>
                            <th>Leave Type</th>
                            <th class="text-end">Days/Year</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var lt in Model.LeaveTypes)
                    {
                        <tr>
                            <td>@lt.Text.Split('(')[0].Trim()</td>
                            <td class="text-end">
                                <span class="badge bg-light text-dark border">
                                    @lt.Text.Split('(')[1].Replace(")", "")
                                </span>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
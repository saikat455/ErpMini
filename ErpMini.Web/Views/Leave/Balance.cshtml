<!-- ErpMini.Web/Views/Leave/Balance.cshtml -->
@model IEnumerable<ErpMini.Application.DTOs.LeaveBalanceDto>
@{ ViewData["Title"] = "Leave Balance"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h5 class="mb-0 fw-semibold">Leave Balance</h5>
        <small class="text-muted">Current year remaining leave</small>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-4">
        <form asp-action="Balance" method="get" class="d-flex gap-2">
            <select name="employeeId" class="form-select form-select-sm">
                @Html.Raw(ViewBag.Employees is SelectList sl
                    ? string.Join("", sl.Select(i =>
                        $"<option value='{i.Value}' {(i.Selected ? "selected" : "")}>{i.Text}</option>"))
                    : "")
            </select>
            <button class="btn btn-sm btn-dark px-3">View</button>
        </form>
    </div>
</div>

@if (ViewBag.SelectedEmployeeId != null && ViewBag.SelectedEmployeeId != 0)
{
    <div class="row g-3">
    @foreach (var balance in Model)
    {
        var pct = balance.Allocated > 0
            ? (int)((balance.Used / (double)balance.Allocated) * 100)
            : 0;
        var barClass = pct >= 90 ? "bg-danger" : pct >= 60 ? "bg-warning" : "bg-success";

        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-3">
                        <span class="fw-medium">@balance.LeaveTypeName</span>
                        <span class="text-muted" style="font-size:.8rem">
                            @balance.Used / @balance.Allocated days
                        </span>
                    </div>
                    <div class="progress mb-3" style="height:6px">
                        <div class="progress-bar @barClass" style="width:@pct%"></div>
                    </div>
                    <div class="d-flex justify-content-between" style="font-size:.8rem">
                        <span class="text-muted">Used: <strong>@balance.Used</strong></span>
                        <span class="text-muted">Remaining: <strong class="text-dark">@balance.Remaining</strong></span>
                    </div>
                </div>
            </div>
        </div>
    }
    </div>
}
else
{
    <div class="text-center text-muted py-4">
        <i class="bi bi-person-check" style="font-size:2rem"></i>
        <p class="mt-2">Select an employee to view their leave balance.</p>
    </div>
}
<!-- ErpMini.Web/Views/Leave/Index.cshtml -->
@model IEnumerable<ErpMini.Application.DTOs.LeaveApplicationDto>
@{ ViewData["Title"] = "Leave Applications"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h5 class="mb-0 fw-semibold">Leave Applications</h5>
        <small class="text-muted">All submitted leave requests</small>
    </div>
    <a asp-action="Apply" class="btn btn-dark btn-sm px-3">
        <i class="bi bi-plus-lg me-1"></i> Apply Leave
    </a>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Employee</th>
                    <th>Department</th>
                    <th>Leave Type</th>
                    <th>From</th>
                    <th>To</th>
                    <th>Days</th>
                    <th>Applied On</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var leave in Model)
            {
                <tr>
                    <td>
                        <div class="fw-medium">@leave.EmployeeName</div>
                        <small class="text-muted">@leave.EmployeeCode</small>
                    </td>
                    <td>@leave.DepartmentName</td>
                    <td>@leave.LeaveTypeName</td>
                    <td>@leave.FromDate.ToString("dd MMM yyyy")</td>
                    <td>@leave.ToDate.ToString("dd MMM yyyy")</td>
                    <td><span class="badge bg-light text-dark border">@leave.TotalDays</span></td>
                    <td>@leave.CreatedAt.ToString("dd MMM yyyy")</td>
                    <td>
                        @{
                            var badgeClass = leave.Status switch
                            {
                                ErpMini.Domain.Enums.LeaveStatus.Approved => "badge-active",
                                ErpMini.Domain.Enums.LeaveStatus.Rejected => "badge-inactive",
                                _ => "bg-warning-subtle text-warning-emphasis border-0"
                            };
                        }
                        <span class="badge @badgeClass">@leave.StatusLabel</span>
                    </td>
                </tr>
            }
            </tbody>
        </table>
        @if (!Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-calendar-x" style="font-size:2rem"></i>
                <p class="mt-2 mb-0">No leave applications found.</p>
            </div>
        }
    </div>
</div>
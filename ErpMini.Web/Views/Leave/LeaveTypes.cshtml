<!-- ErpMini.Web/Views/Leave/LeaveTypes.cshtml -->
@model IEnumerable<ErpMini.Application.DTOs.LeaveTypeDto>
@{ ViewData["Title"] = "Leave Types"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h5 class="mb-0 fw-semibold">Leave Types</h5>
        <small class="text-muted">Configure leave categories</small>
    </div>
    <button class="btn btn-dark btn-sm px-3" data-bs-toggle="modal" data-bs-target="#addModal">
        <i class="bi bi-plus-lg me-1"></i> Add Type
    </button>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Days / Year</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var lt in Model)
            {
                <tr>
                    <td class="fw-medium">@lt.Name</td>
                    <td class="text-muted">@(lt.Description ?? "—")</td>
                    <td><span class="badge bg-light text-dark border">@lt.TotalDays</span></td>
                    <td><span class="badge @(lt.IsActive ? "badge-active" : "badge-inactive")">
                        @(lt.IsActive ? "Active" : "Inactive")</span></td>
                    <td class="text-end pe-3">
                        <form asp-action="DeleteLeaveType" asp-route-id="@lt.Id"
                              method="post" class="d-inline"
                              onsubmit="return confirm('Delete @lt.Name?')">
                            @Html.AntiForgeryToken()
                            <button class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<!-- Add Modal -->
<div class="modal fade" id="addModal" tabindex="-1">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h6 class="modal-title fw-semibold">Add Leave Type</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="CreateLeaveType" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-medium">Name</label>
                        <input name="name" class="form-control" required placeholder="e.g. Maternity Leave" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-medium">Days Per Year</label>
                        <input name="totalDays" type="number" class="form-control" min="1" required />
                    </div>
                    <div class="mb-2">
                        <label class="form-label fw-medium">Description</label>
                        <input name="description" class="form-control" placeholder="Optional" />
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="submit" class="btn btn-dark btn-sm">Add</button>
                    <button type="button" class="btn btn-outline-secondary btn-sm"
                            data-bs-dismiss="modal">Cancel</button>
                </div>
            </form>
        </div>
    </div>
</div>
<!-- ErpMini.Web/Views/Leave/Pending.cshtml -->
@model IEnumerable<ErpMini.Application.DTOs.LeaveApplicationDto>
@{ ViewData["Title"] = "Pending Approvals"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h5 class="mb-0 fw-semibold">Pending Approvals</h5>
        <small class="text-muted">@Model.Count() application(s) awaiting action</small>
    </div>
</div>

@if (!Model.Any())
{
    <div class="card">
        <div class="text-center py-5 text-muted">
            <i class="bi bi-check-circle" style="font-size:2rem"></i>
            <p class="mt-2 mb-0">No pending leave applications.</p>
        </div>
    </div>
}

@foreach (var leave in Model)
{
    <div class="card mb-3">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <h6 class="fw-semibold mb-1">@leave.EmployeeName
                        <small class="text-muted fw-normal">@leave.EmployeeCode</small>
                    </h6>
                    <div class="text-muted" style="font-size:.8rem">
                        @leave.DepartmentName &nbsp;·&nbsp;
                        <span class="text-dark">@leave.LeaveTypeName</span> &nbsp;·&nbsp;
                        @leave.FromDate.ToString("dd MMM") – @leave.ToDate.ToString("dd MMM yyyy")
                        &nbsp;·&nbsp; <strong>@leave.TotalDays day(s)</strong>
                    </div>
                    <p class="mt-2 mb-0" style="font-size:.85rem">
                        <span class="text-muted">Reason:</span> @leave.Reason
                    </p>
                </div>
                <div class="d-flex gap-2 ms-3 flex-shrink-0">
                    <form asp-action="Approve" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@leave.Id" />
                        <button class="btn btn-sm btn-outline-success">
                            <i class="bi bi-check-lg me-1"></i>Approve
                        </button>
                    </form>
                    <button class="btn btn-sm btn-outline-danger"
                            data-bs-toggle="modal" data-bs-target="#rejectModal-@leave.Id">
                        <i class="bi bi-x-lg me-1"></i>Reject
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Reject modal per card -->
    <div class="modal fade" id="rejectModal-@leave.Id" tabindex="-1">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header border-0 pb-0">
                    <h6 class="modal-title fw-semibold">Reject Leave</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form asp-action="Reject" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="LeaveId" value="@leave.Id" />
                    <div class="modal-body">
                        <p class="text-muted small mb-3">
                            Rejecting leave for <strong>@leave.EmployeeName</strong>
                        </p>
                        <label class="form-label fw-medium">Reason for rejection</label>
                        <textarea name="Reason" class="form-control" rows="3"
                                  placeholder="Provide a reason..." required></textarea>
                    </div>
                    <div class="modal-footer border-0 pt-0">
                        <button type="submit" class="btn btn-danger btn-sm">Reject</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm"
                                data-bs-dismiss="modal">Cancel</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
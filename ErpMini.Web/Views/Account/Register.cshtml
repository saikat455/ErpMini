<!-- ErpMini.Web/Views/Account/Register.cshtml -->
@model ErpMini.Web.ViewModels.RegisterViewModel
@{ Layout = null; }
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Register — ERP Mini</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        body { background: #f4f6f9; }
        .register-card { max-width: 460px; margin: 3rem auto; }
        .brand { font-size: 1.1rem; font-weight: 700; color: #1e2a3a; }
        .form-control:focus { border-color: #1e2a3a; box-shadow: 0 0 0 .2rem rgba(30,42,58,.15); }
        .type-card {
            border: 2px solid #e5e9ef; border-radius: 10px;
            padding: 1rem; cursor: pointer; transition: all .15s;
            background: #fff; text-align: center;
        }
        .type-card:hover { border-color: #9ca3af; }
        .type-card.selected { border-color: #1e2a3a; background: #f0f4f8; }
        .type-card h6 { margin: .4rem 0 0; font-size: .88rem; font-weight: 600; }
        .type-card p  { margin: 0; font-size: .72rem; color: #6b7280; }
        .type-card i  { font-size: 1.5rem; color: #1e2a3a; }
        .info-box {
            background: #f0f9ff; border: 1px solid #bae6fd;
            border-radius: 6px; padding: .75rem 1rem;
            font-size: .8rem; color: #0369a1;
        }
    </style>
</head>
<body>
<div class="register-card px-3">
    <div class="text-center mb-4">
        <div class="brand">
            <i class="bi bi-grid-3x3-gap-fill me-2"></i>ERP Mini
        </div>
        <p class="text-muted mt-1" style="font-size:.85rem">
            Create your account
        </p>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success py-2 mb-3" style="font-size:.85rem">
                    <i class="bi bi-check-circle me-1"></i>@TempData["Success"]
                </div>
            }
            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger py-2 mb-3" style="font-size:.85rem">
                    <i class="bi bi-exclamation-circle me-1"></i>@ViewBag.Error
                </div>
            }

            <form asp-action="Register" method="post">
                @Html.AntiForgeryToken()

                <!-- Account type -->
                <div class="mb-4">
                    <label class="form-label fw-medium mb-2"
                           style="font-size:.875rem">
                        I am registering as
                    </label>
                    <div class="row g-2">
                        <div class="col-6">
                            <div class="type-card selected" id="adminCard"
                                 onclick="selectType('Admin')">
                                <i class="bi bi-shield-check"></i>
                                <h6>Admin</h6>
                                <p>Setting up a new company</p>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="type-card" id="empCard"
                                 onclick="selectType('Employee')">
                                <i class="bi bi-person-badge"></i>
                                <h6>Employee</h6>
                                <p>Joining an existing company</p>
                            </div>
                        </div>
                    </div>
                    <input type="hidden" name="AccountType"
                           id="accountTypeInput" value="Admin" />
                </div>

                <!-- Common fields -->
                <div class="mb-3">
                    <label class="form-label fw-medium"
                           style="font-size:.875rem">Full Name</label>
                    <input type="text" name="FullName" class="form-control"
                           value="@Model.FullName"
                           placeholder="Your full name" required autofocus />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-medium"
                           style="font-size:.875rem">Email Address</label>
                    <input type="email" name="Email" class="form-control"
                           value="@Model.Email"
                           placeholder="you@example.com" required />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-medium"
                           style="font-size:.875rem">Password</label>
                    <input type="password" name="Password" class="form-control"
                           placeholder="Min 8 chars, include a number" required />
                </div>

                <!-- Admin fields -->
                <div id="adminSection">
                    <div class="mb-3">
                        <label class="form-label fw-medium"
                               style="font-size:.875rem">Company Name</label>
                        <input type="text" name="CompanyName" class="form-control"
                               value="@Model.CompanyName"
                               placeholder="e.g. Acme Corporation" />
                    </div>
                    <div class="info-box mb-3">
                        <i class="bi bi-info-circle me-1"></i>
                        After registration, a unique <strong>Company Code</strong>
                        will be shown on your dashboard.
                        Share it with employees so they can join your company.
                    </div>
                </div>

                <!-- Employee fields -->
                <div id="empSection" style="display:none">
                    <div class="mb-3">
                        <label class="form-label fw-medium"
                               style="font-size:.875rem">Company Code</label>
                        <input type="text" name="CompanyCode" class="form-control"
                               value="@Model.CompanyCode"
                               placeholder="e.g. ACME4821"
                               style="text-transform:uppercase;letter-spacing:.1em" />
                        <div class="form-text">
                            Ask your company admin for this code.
                        </div>
                    </div>
                </div>

                <button type="submit" class="btn btn-dark w-100 mt-1">
                    Create Account
                </button>
            </form>

            <hr class="my-3">
            <p class="text-center text-muted mb-0" style="font-size:.82rem">
                Already have an account?
                <a asp-action="Login" class="text-dark fw-medium">Sign in</a>
            </p>
        </div>
    </div>
</div>

<script>
    function selectType(type) {
        document.getElementById('accountTypeInput').value = type;
        document.getElementById('adminCard').classList
            .toggle('selected', type === 'Admin');
        document.getElementById('empCard').classList
            .toggle('selected', type === 'Employee');
        document.getElementById('adminSection').style.display =
            type === 'Admin' ? '' : 'none';
        document.getElementById('empSection').style.display =
            type === 'Employee' ? '' : 'none';
    }

    // Restore selection if form was re-shown after error
    const stored = document.getElementById('accountTypeInput').value;
    if (stored) selectType(stored);
</script>
</body>
</html>
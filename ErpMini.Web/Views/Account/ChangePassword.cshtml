<!-- ErpMini.Web/Views/Account/ChangePassword.cshtml -->
@{ Layout = "_Layout"; ViewData["Title"] = "Change Password"; }

<div class="d-flex align-items-center gap-2 mb-4">
    <a asp-controller="Dashboard" asp-action="Index"
       class="btn btn-sm btn-outline-secondary">
        <i class="bi bi-arrow-left"></i>
    </a>
    <div>
        <p class="page-header-title">Change Password</p>
        <p class="page-header-sub">Update your account password</p>
    </div>
</div>

<div class="row">
    <div class="col-md-5">
        <div class="card">
            <div class="card-header">New Password</div>
            <div class="card-body">
                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger py-2" style="font-size:.85rem">
                        @ViewBag.Error
                    </div>
                }
                <form asp-action="ChangePassword" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label fw-medium">Current Password</label>
                        <input type="password" name="currentPassword"
                               class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-medium">New Password</label>
                        <input type="password" name="newPassword"
                               class="form-control" required
                               placeholder="Min 8 characters, include a number" />
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-medium">Confirm New Password</label>
                        <input type="password" name="confirmPassword"
                               class="form-control" required />
                    </div>
                    <button type="submit" class="btn btn-dark w-100">
                        Update Password
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
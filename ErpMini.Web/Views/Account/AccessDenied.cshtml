@{
    ViewData["Title"] = "Access Denied";
}

<div class="d-flex align-items-center gap-2 mb-4">
    <a asp-controller="Account" asp-action="Login" class="btn btn-sm btn-outline-secondary">
        <i class="bi bi-arrow-left"></i>
    </a>
    <div>
        <p class="page-header-title">Access Denied</p>
        <p class="page-header-sub">You don't have permission to view this page</p>
    </div>
</div>

<div class="card">
    <div class="card-body text-center py-5">
        <i class="bi bi-shield-exclamation" style="font-size: 4rem; color: #dc3545;"></i>
        <h4 class="mt-3">Access Restricted</h4>
        <p class="text-muted mb-4">This area is only available to administrators.</p>
        <a asp-controller="Employee" asp-action="MyProfile" class="btn btn-dark">
            <i class="bi bi-person-circle me-1"></i> Go to My Profile
        </a>
    </div>
</div>

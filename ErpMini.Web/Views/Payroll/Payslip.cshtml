<!-- ErpMini.Web/Views/Payroll/Payslip.cshtml -->
@model ErpMini.Application.DTOs.PayrollDto
@{ ViewData["Title"] = "Payslip"; }

<div class="d-flex align-items-center gap-2 mb-4">
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
        <i class="bi bi-arrow-left"></i>
    </a>
    <div class="flex-grow-1">
        <p class="page-header-title">Payslip</p>
        <p class="page-header-sub">@Model.MonthName</p>
    </div>
    <button onclick="window.print()" class="btn btn-sm btn-outline-secondary">
        <i class="bi bi-printer me-1"></i> Print
    </button>
</div>

<div class="card" style="max-width:680px" id="payslip">
    <div class="card-body p-4">
        <!-- Header -->
        <div class="d-flex justify-content-between align-items-start mb-4 pb-3 border-bottom">
            <div>
                <h5 class="fw-bold mb-0" style="color:#1e2a3a">ERP Mini</h5>
                <div class="text-muted" style="font-size:.8rem">Payslip for @Model.MonthName</div>
            </div>
            <div class="text-end">
                <span class="badge @(Model.Status == ErpMini.Domain.Enums.PayrollStatus.Paid ? "badge-active" : "badge-pending") fs-6">
                    @Model.StatusLabel
                </span>
            </div>
        </div>

        <!-- Employee Info -->
        <div class="row mb-4">
            <div class="col-6">
                <div class="text-muted mb-1" style="font-size:.75rem;text-transform:uppercase;letter-spacing:.05em">Employee</div>
                <div class="fw-semibold">@Model.EmployeeName</div>
                <div class="text-muted" style="font-size:.82rem">@Model.EmployeeCode</div>
            </div>
            <div class="col-6">
                <div class="text-muted mb-1" style="font-size:.75rem;text-transform:uppercase;letter-spacing:.05em">Department</div>
                <div class="fw-semibold">@Model.DepartmentName</div>
                <div class="text-muted" style="font-size:.82rem">@Model.DesignationTitle</div>
            </div>
        </div>

        <!-- Salary Breakdown -->
        <table class="table mb-0" style="font-size:.875rem">
            <thead>
                <tr>
                    <th>Description</th>
                    <th class="text-end">Amount (৳)</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Basic Salary</td>
                    <td class="text-end">@Model.BasicSalary.ToString("N2")</td>
                </tr>
                <tr>
                    <td class="text-success">Bonus</td>
                    <td class="text-end text-success">+ @Model.Bonus.ToString("N2")</td>
                </tr>
                <tr>
                    <td class="text-danger">Deduction</td>
                    <td class="text-end text-danger">- @Model.Deduction.ToString("N2")</td>
                </tr>
            </tbody>
            <tfoot>
                <tr style="border-top:2px solid #e5e9ef">
                    <td class="fw-bold">Net Salary</td>
                    <td class="text-end fw-bold fs-6">৳ @Model.NetSalary.ToString("N2")</td>
                </tr>
            </tfoot>
        </table>

        @if (!string.IsNullOrEmpty(Model.Note))
        {
            <div class="mt-3 p-3 rounded" style="background:#f8f9fa;font-size:.82rem">
                <span class="text-muted">Note:</span> @Model.Note
            </div>
        }

        <div class="mt-4 pt-3 border-top d-flex justify-content-between text-muted" style="font-size:.75rem">
            <span>Generated by: @(Model.GeneratedBy ?? "System")</span>
            <span>@Model.GeneratedOn.ToString("dd MMM yyyy, hh:mm tt")</span>
        </div>
    </div>
</div>

@section Scripts {
<style>
    @@media print {
        .sidebar, .topbar, .d-flex.align-items-center.gap-2.mb-4 { display: none !important; }
        .main-content { margin-left: 0 !important; }
        .page-content { padding: 0 !important; }
    }
</style>
}